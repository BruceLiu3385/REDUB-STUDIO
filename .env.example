# Example only. The application does not automatically load this file.
# In Linux, copy to .env, review it, then run: set -a; source .env; set +a
# Set REDUB_PROJECT_ROOT to the absolute directory containing apps/ and deploy/.
# REDUB_PROJECT_ROOT=/absolute/path/REDUB-STUDIO

REDUB_WEB_ROOT=/root/autodl-tmp/redub-web
REDUB_WEB_ENV=/root/autodl-tmp/redub-web/env
REDUB_TBDUB_ROOT=/root/autodl-tmp/tbdub
REDUB_TBDUB_ENV=/root/autodl-tmp/tbdub/env
REDUB_VOICE_ROOT=/root/autodl-tmp/redub-voice
REDUB_VOICE_ENV=/root/autodl-tmp/redub-voice/env
REDUB_SEPARATOR_ROOT=/root/autodl-tmp/redub-separator
REDUB_SEPARATOR_ENV=/root/autodl-tmp/redub-separator/env
REDUB_DATA_DIR=/root/autodl-tmp/redub-data
REDUB_UPSCALE_MODEL=/root/autodl-tmp/redub-upscale/RealESRGAN_x2plus.pth
REDUB_PORT=7860
# Notebook link prefix; use / for Jupyter installations served from the root.
REDUB_JUPYTER_BASE_URL=/jupyter/

# Set these explicitly if FFmpeg and ffprobe are not in the expected locations.
# REDUB_FFMPEG=/root/autodl-tmp/tbdub/env/bin/ffmpeg
# REDUB_FFPROBE=/usr/bin/ffprobe

# TBDub installation scripts use their own TBDUB_* variables.
TBDUB_ROOT=/root/autodl-tmp/tbdub
TBDUB_ENV=/root/autodl-tmp/tbdub/env
